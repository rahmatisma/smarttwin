APP_NAME=SmartTwin Backend
APP_VERSION=0.1.0
DEBUG=true
CORS_ORIGINS=http://localhost:3000
AUTH_REQUIRED=false
OPERATOR_ROLES=operator,admin,service_role
MAX_VIDEO_UPLOAD_BYTES=1073741824

# Opsional: true membuat Scenario Generator langsung menjalankan tiga kandidat
# SUMO saat backend start. Biarkan false bila SUMO hanya boleh start dari UI.
SCENARIO_WORKER_AUTOSTART=false
SCENARIO_WORKER_INTERVAL_SECONDS=60

# Supabase API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hugging Face Hub
HF_TOKEN=
HF_REPO_ID=rahmatisma/smarttwin-cctv

# Decision Engine (default aman: rule-based)
SMARTTWIN_DECISION_ENGINE=rule-based
# Diisi hanya setelah checkpoint PPO lolos evaluasi terhadap baseline.
SMARTTWIN_PPO_MODEL_PATH=decision_engine/models/smarttwin_ppo.zip
# Crop kamera live SUMO untuk dashboard: xmin,ymin,xmax,ymax.
# Rentang makin kecil = zoom makin dekat. Restart backend/SUMO setelah diubah.
SMARTTWIN_SUMO_VIEW_BOUNDARY=240.63,479.635,380.63,558.385
