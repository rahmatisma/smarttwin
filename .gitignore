# Python
__pycache__/
*.pyc
*.py[cod]
.venv/
venv/
cv/venv/
forecasting/.venv/
.env
.env.*
!.env.example

# pip cache — jangan pernah di-commit, ini cache lokal
pip-cache/

# Backup/scratch zip di root repo -- 24 Agustus 2026 ada backend.zip
# (2,23 GB) ke-commit tanpa sengaja lewat `git add -A` pas resolve
# conflict, bikin push gagal berulang kali (timeout). data/*.zip di
# bawah tidak menutup ini karena file-nya ada di root, bukan di data/.
*.zip

# CCTV videos
cv/videos/
cv/models/

# Cache video CCTV backend (lihat backend/app/api/routes/cctv.py) --
# salinan lokal video yang sudah pernah ditonton, regenerated dari
# Hugging Face, tidak pernah perlu di-commit.
backend/cache/

# Output CV di-ignore secara umum (regenerated tiap run). Dua jenis
# berkas dikecualikan secara sadar:
#   1. dataset hasil run Melpi 14 Agustus 2026 — baseline/bukti laporan.
#   2. sync_report.* — metadata produksi: offset & durasi potong tiap
#      kamera, satu-satunya catatan bagaimana CCTV_*_sync.mp4 dibuat.
# CSV dan JSON diperlakukan sama supaya sync_report tidak lagi terbelah
# (dulu .csv kena `cv/output/*.csv` sementara .json lolos tanpa aturan).
cv/output/*.csv
cv/output/*.json
!cv/output/smarttwin_traffic_data_melpi_20260814.csv
!cv/output/sync_report.csv
!cv/output/sync_report.json

# Peta jam per video — dibuat ulang tiap `sync_videos.py --dry-run`
cv/output/clockmap/

# Arsip investigasi sinkronisasi: disimpan di disk sebagai barang bukti,
# tapi bukan jalur produksi dan terlalu besar untuk riwayat git.
# README-nya ikut supaya isinya tetap terdokumentasi di repo.
cv/_arsip/*
!cv/_arsip/README.md

# Dataset
data/*.csv
data/*.zip
data/*.parquet

# Forecasting datasets, model, hasil training
forecasting/data/*
forecasting/models/*
forecasting/outputs/*
!forecasting/data/.gitkeep
!forecasting/models/.gitkeep
!forecasting/outputs/.gitkeep

# Node
node_modules/
.next/
dist/
build/

# SUMO run outputs (regenerated tiap run, jangan di-commit)
simulation/outputs/*
!simulation/outputs/.gitkeep

# Folder hasil osmWebWizard (nama = timestamp), jangan ke-track otomatis
simulation/20*-*-*-*/

