# Python
__pycache__/
*.pyc
*.py[cod]
.venv/
venv/
cv/venv/
forecasting/.venv/

# pip cache — jangan pernah di-commit, ini cache lokal
pip-cache/

# CCTV videos
cv/videos/
cv/models/

# Output CV di-ignore secara umum (regenerated tiap run), KECUALI
# dataset hasil run Melpi 14 Agustus 2026 yang disimpan sebagai
# baseline/bukti untuk laporan teknis.
cv/output/*.csv
!cv/output/smarttwin_traffic_data_melpi_20260814.csv

# Dataset
data/*.csv
data/*.zip
data/*.parquet

# Forecasting datasets, model, hasil training
forecasting/data/*
forecasting/models/*
forecasting/outputs/*
!forecasting/data/.gitkeep
!forecasting/models/.gitkeep
!forecasting/outputs/.gitkeep

# Node
node_modules/
.next/
dist/
build/

# SUMO run outputs (regenerated tiap run, jangan di-commit)
simulation/outputs/*
!simulation/outputs/.gitkeep

# Folder hasil osmWebWizard (nama = timestamp), jangan ke-track otomatis
simulation/20*-*-*-*/

# env
.env
